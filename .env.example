# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 커밋하지 않습니다.

# LLM (SSAFY GMS, OpenAI 호환)
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# 외부 API
KAKAO_REST_KEY=
ODSAY_API_KEY=
DATA_GO_KR_KEY=
ITS_API_KEY=

# Agent 설정
AGENT_MODE=single
WORKER_LLM=on
MAX_REPLAN=3
WORKER_MAX_RETRY=2
LOGGING_ENABLED=true
CALENDAR_BACKEND=local
GOOGLE_CALENDAR_ID=primary
DEBUG_FORCE=

# 호출 한도 (설계 19장)
ODSAY_DAILY_LIMIT=30
ODSAY_RESERVE=6
QUOTA_USE_RESERVE=false
ITS_MONTHLY_LIMIT=100
ITS_DAILY_SOFT=4
