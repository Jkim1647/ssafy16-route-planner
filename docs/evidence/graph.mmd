---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	analyze(analyze)
	clarify(clarify)
	plan(plan)
	execute(execute)
	verify(verify)
	judge(judge)
	replan(replan)
	respond(respond)
	action(action)
	__end__([<p>__end__</p>]):::last
	__start__ --> analyze;
	analyze -.-> action;
	analyze -.-> clarify;
	analyze -.-> plan;
	analyze -.-> respond;
	execute -.-> judge;
	execute -.-> respond;
	execute -.-> verify;
	judge -.-> replan;
	judge -.-> respond;
	plan --> execute;
	replan --> plan;
	verify -.-> judge;
	verify -.-> replan;
	action --> __end__;
	clarify --> __end__;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
