      "type": "string",
      "title": "Leave At"
     },
     "arrive_at": {
      "type": "string",
      "title": "Arrive At"
     },
     "origin_name": {
      "type": "string",
      "minLength": 1,
      "title": "Origin Name"
     },
     "destination_name": {
      "type": "string",
      "minLength": 1,
      "title": "Destination Name"
     },
     "legs": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Legs",
      "default": []
     },
     "total_fare": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Total Fare"
     },
