      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "title": "Title"
     },
     "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
     },
     "leave_at": {
      "type": "string",
      "title": "Leave At"
     },
     "arrive_at": {
      "type": "string",
      "title": "Arrive At"
     },
     "origin_name": {
      "type": "string",
      "minLength": 1,
      "title": "Origin Name"
     },
     "destination_name": {
      "type": "string",
      "minLength": 1,
      "title": "Destination Name"
     },
     "legs": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Legs",
      "default": []
     },
     "total_fare": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Total Fare"
     },
     "source_run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Run Id"
     },
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "calendar_event_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Calendar Event Id"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At"
     }
    },
    "type": "object",
    "required": [
     "title",
     "date",
     "leave_at",
     "arrive_at",
     "origin_name",
     "destination_name",
     "id",
     "created_at",
     "updated_at"
    ],
    "title": "PlanOut"
