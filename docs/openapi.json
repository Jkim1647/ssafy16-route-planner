 "components": {
  "schemas": {
   "ChatIn": {
    "properties": {
     "message": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Message"
     },
     "session_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "ChatIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LegIn": {
    "properties": {
     "mode": {
      "type": "string",
      "maxLength": 20,
      "title": "Mode"
     },
     "name": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 100
       },
       {
        "type": "null"
       }
      ],
      "title": "Name"
     },
     "minutes": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 10000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Minutes"
     },
     "fare": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 10000000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Fare"
     },
     "source": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 30
       },
       {
        "type": "null"
       }
      ],
      "title": "Source"
     },
     "path": {
      "anyOf": [
       {
        "items": {
         "items": {
          "type": "number"
         },
         "type": "array",
         "maxItems": 2,
         "minItems": 2
        },
        "type": "array",
        "maxItems": 400
       },
       {
        "type": "null"
       }
      ],
      "title": "Path"
     },
     "line_code": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Line Code"
     }
    },
    "type": "object",
    "required": [
     "mode"
    ],
    "title": "LegIn",
    "description": "계획에 저장하는 구간(경로 카드의 legs와 같은 모양). 크기 상한으로 저장소 남용을 막는다."
   },
   "PlaceIn": {
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "title": "Label"
     },
     "kind": {
      "type": "string",
      "pattern": "^(home|school|work|pin)$",
      "title": "Kind",
      "default": "pin"
     },
     "name": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "title": "Name"
     },
     "address": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Address"
     },
     "x": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "X"
     },
     "y": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Y"
     }
    },
    "type": "object",
    "required": [
     "label",
     "name",
     "x",
     "y"
    ],
    "title": "PlaceIn",
    "description": "저장한 장소. label은 대화에서 부르는 이름(예: 집, 교육장)으로 사용자마다 하나씩."
   },
   "PlaceOut": {
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "title": "Label"
     },
     "kind": {
      "type": "string",
      "pattern": "^(home|school|work|pin)$",
      "title": "Kind",
      "default": "pin"
     },
     "name": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "title": "Name"
     },
     "address": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "null"
       }
      ],
      "title": "Address"
     },
     "x": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "X"
     },
     "y": {
      "type": "number",
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Y"
     },
     "id": {
      "type": "integer",
