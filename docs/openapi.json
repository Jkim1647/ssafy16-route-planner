 "components": {
  "schemas": {
   "ChatIn": {
    "properties": {
     "message": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "title": "Message"
     },
     "session_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "ChatIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PlanIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "title": "Title"
     },
     "date": {
      "type": "string",
