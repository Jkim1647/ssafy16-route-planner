       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "date": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Date"
     },
     "leave_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Leave At"
     },
     "arrive_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Arrive At"
     },
     "origin_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Origin Name"
     },
     "destination_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Destination Name"
     }
    },
    "type": "object",
    "title": "PlanUpdate"
   },
   "TurnResult": {
    "properties": {
     "run_id": {
      "type": "string",
      "title": "Run Id"
     },
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "reply": {
      "type": "string",
      "title": "Reply"
     },
     "cards": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Cards",
      "default": []
     },
     "excluded": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Excluded",
      "default": []
     },
     "undetermined": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Undetermined",
      "default": []
     },
     "estimated": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Estimated",
      "default": []
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Warnings",
      "default": []
     },
     "clarification": {
      "anyOf": [
       {
        "type": "string"
